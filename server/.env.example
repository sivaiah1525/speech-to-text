# Copy this file to .env and fill in the values.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speech_to_text
# Set to true for hosted Postgres (Neon, Render, Supabase) that requires SSL
DB_SSL=false

# Optional: enables the "Gemini Live" engine. Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
